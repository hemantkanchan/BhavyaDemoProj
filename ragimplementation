def _sanitize_documents(docs):
    """Return a list of Documents whose page_content are strings.

    This prevents downstream embedding code from receiving dicts or other
    non-string types which call `.replace` on each text.
    """
    sanitized = []
    for d in docs:
        try:
            content = d.page_content if hasattr(d, "page_content") else d.get("page_content")
        except Exception:
            content = d
        if isinstance(content, dict):
            # common keys used for text content
            content = content.get("text") or content.get("content") or str(content)
        sanitized.append(Document(page_content=str(content), metadata=getattr(d, "metadata", None) or (d.get("metadata") if isinstance(d, dict) else None)))
    return sanitized

