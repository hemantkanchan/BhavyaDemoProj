def fmt_prompt_with_context(query: str, context_docs: list[Document]) -> str:
    """Format the prompt with the retrieved context documents."""
    context_text = "\n\n".join(
        f"Source: {doc.metadata.get('source', 'unknown')}\nContent: {doc.page_content}"
        for doc in context_docs
    )
    return f"{context_text}\n\nQuestion: {query}\nAnswer:"


def _ensure_str_output(x):
    """Normalize LLM output to a string for downstream parsers.

    Many LLM run wrappers sometimes return dict-like responses (e.g. {'text': ...}
    or {'content': ...}) instead of raw strings. `StrOutputParser` expects a
    string and calls string methods like `replace` internally, so we must
    extract the text here.
    """
    if isinstance(x, str):
        return x
    if isinstance(x, dict):
        return x.get("text") or x.get("content") or str(x)
    return str(x)

# LCEL: LangChain Expression Language. Components are chained with `|`.
# Same idea as `cat file | grep ... | wc -l` in a Unix shell.
chain = (
    {
        # Ensure retriever is invoked with the question string only
        # directly run a similarity search on the FAISS vectorstore with the question string
        "context": RunnableLambda(lambda inp: vectorstore.similarity_search(
            (inp["question"].get("text") if isinstance(inp["question"], dict) else inp["question"]),
            k=3
        )),
        "question": RunnablePassthrough(),
    }
    | RunnableLambda(
        lambda x: {
            "context": fmt_prompt_with_context(x["question"], x["context"]),
            "question": x["question"],
        }
    )
    | betterprompt
    | llm
    | RunnableLambda(_ensure_str_output)
    | StrOutputParser()
)
# ── Run ────────────────────────────────────────────────
for q in [
    "If my parent's 60th birthday falls in my first year, how many days of leave do I get?",
    "How many days of annual leave does someone with 7 years of tenure get?",
    "Can a new hire work from home?",
    "Does the company cover lunch?",  # not in the docs → should refuse
]:
    print(f"\n━━━ Q: {q}\n> {chain.invoke({'question': q})}")